# Godot cache
.godot/

# Exported builds
/build/

# Python cache
__pycache__/

# Notes and docs that are not part of the game
*.md
!README.md
!CONTRIBUTING.md
/docs/

# Local reference material and verification screenshots
/reference/

# Bản dịch sinh ra khi import strings.csv
game/i18n/*.translation

# Bộ asset Kenney gốc: game chỉ dùng phần đã chép vào game/assets/vendor/ (tools/assets/copy_vendor.sh)
/vendor/

# Âm thanh tự sinh là asset của game (gitignore toàn cục của máy có *.wav)
!game/assets/audio/sfx/*.wav
